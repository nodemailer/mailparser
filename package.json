{
    "name": "mailparser",
    "version": "3.9.47",
    "description": "Parse e-mails",
    "main": "index.js",
    "scripts": {
        "test": "node --test test/*-test.js",
        "test:coverage": "c8 npm test",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "author": "Andris Reinman",
    "contributors": [
        {
            "name": "Peter Salomonsen",
            "email": "petersalomonsen@runbox.com",
            "url": "https://github.com/petersalomonsen"
        }
    ],
    "license": "MIT",
    "dependencies": {
        "@zone-eu/mailsplit": "5.4.27",
        "encoding-japanese": "2.4.0",
        "he": "1.2.0",
        "html-to-text": "10.0.1",
        "iconv-lite": "0.7.3",
        "libmime": "5.5.2",
        "linkify-it": "5.0.2",
        "nodemailer": "10.1.7",
        "punycode.js": "2.3.1",
        "tlds": "1.261.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "iconv": "3.0.1",
        "prettier": "3.9.10",
        "random-message": "1.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nodemailer/mailparser.git"
    },
    "bugs": {
        "url": "https://github.com/nodemailer/mailparser/issues"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
